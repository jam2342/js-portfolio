---
import { detector, pct } from "../data/model";

/**
 * Detector evaluation, drawn as paired bars. Two panels rather than one chart
 * because the two evaluations answer different questions and should not be
 * read as a single trend line.
 */

const rows = [
  { key: "map50", label: "mAP@50" },
  { key: "map5095", label: "mAP@50-95" },
  { key: "precision", label: "Precision" },
  { key: "recall", label: "Recall" },
] as const;
---

<div class="metrics">
  <div class="metrics-panel">
    <p class="mono panel-head">v1 · validation split · 80 epochs, A100</p>
    <p class="panel-sub">Frames drawn from the same pool the model trained on.</p>
    {
      rows.map((r) => (
        <div class="bar-row">
          <span class="bar-label mono">{r.label}</span>
          <div class="bar-track">
            <div class="bar-fill" style={`--w:${detector.v1[r.key] * 100}%`} />
          </div>
          <span class="bar-val mono">{pct(detector.v1[r.key])}</span>
        </div>
      ))
    }
  </div>

  <div class="metrics-panel">
    <p class="mono panel-head">
      v2 · held-out event · {detector.holdoutEvent}
    </p>
    <p class="panel-sub">
      An event the model never saw during training. This is the honest number.
    </p>
    {
      rows.map((r) => (
        <div class="bar-row">
          <span class="bar-label mono">{r.label}</span>
          <div class="bar-track">
            <div class="bar-fill is-holdout" style={`--w:${detector.v2[r.key] * 100}%`} />
          </div>
          <span class="bar-val mono">{pct(detector.v2[r.key])}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    margin: 2.25rem 0 1rem;
    overflow: hidden;
  }

  .metrics-panel {
    background: var(--paper-2);
    padding: 1.1rem;
  }

  .panel-head {
    margin: 0 0 0.3rem;
    color: var(--ink-2);
  }

  .panel-sub {
    margin: 0 0 1.1rem;
    font-size: 0.84rem;
    color: var(--ink-3);
    line-height: 1.45;
    min-height: 2.4em;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 5.6rem 1fr 3.1rem;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.62rem;
  }

  .bar-label {
    font-size: 0.63rem;
  }

  .bar-track {
    height: 6px;
    background: var(--rule);
    border-radius: 1px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
    border-radius: 1px;
    /* Grows once the figure scrolls into view. */
    transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bar-fill.is-holdout {
    background: var(--flag);
  }

  .metrics.in .bar-fill {
    width: var(--w);
  }

  .bar-val {
    font-size: 0.68rem;
    text-align: right;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-fill {
      width: var(--w);
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .metrics {
      grid-template-columns: 1fr;
    }

    .panel-sub {
      min-height: 0;
    }
  }
</style>

<script>
  const el = document.querySelector(".metrics");
  if (el) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.classList.add("in");
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.25 }
      );
      io.observe(el);
    }
  }
</script>
