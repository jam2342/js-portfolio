---
import Base from "../layouts/Base.astro";
import { nav } from "../data/site";
---

<Base title="Page not found, Jamal Mammadzada">
  <section class="wrap notfound">
    <p class="mono">Error 404</p>
    <h1 class="h-lg">That page doesn't exist.</h1>
    <p class="lede narrow">
      The link may be out of date, or the page may have moved. Here's everything
      that does exist:
    </p>

    <ul class="nf-list" role="list">
      <li><a href="/" class="arrow">Home</a></li>
      {nav.map((item) => <li><a href={item.href} class="arrow">{item.label}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .notfound {
    padding-block: clamp(4rem, 12vw, 8rem);
  }

  .notfound .mono {
    margin-bottom: 1.1rem;
    color: var(--flag);
  }

  .notfound h1 {
    margin-bottom: 1.25rem;
  }

  .nf-list {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
</style>
